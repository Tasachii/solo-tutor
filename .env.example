# Public browser configuration only. Do not put sb_secret_, service_role, or LINE credentials here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Leave empty while demonstrating. Paid requests stay unavailable until these are real.
VITE_SUPPORT_CONTACT=
VITE_PROVIDER_LEGAL_NAME=
VITE_SOLO_PROMPTPAY=

# Browser integration tests inject synthetic values via npm run e2e:mock.

# Dedicated frontend hosting may use /. Default remains /solo-tutor/ for existing Pages links.
VITE_BASE_PATH=/solo-tutor/
